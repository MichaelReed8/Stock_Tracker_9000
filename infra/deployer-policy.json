{
  "Version": "2012-10-17",
  "Statement": [
    { "Sid": "CreateTaggedAppUserPool", "Effect": "Allow", "Action": "cognito-idp:CreateUserPool", "Resource": "*", "Condition": { "StringEquals": { "aws:RequestTag/Application": "stock-tracker-9000" } } },
    { "Sid": "ManageTaggedAppUserPool", "Effect": "Allow", "Action": ["cognito-idp:DescribeUserPool", "cognito-idp:UpdateUserPool", "cognito-idp:DeleteUserPool", "cognito-idp:GetUserPoolMfaConfig", "cognito-idp:SetUserPoolMfaConfig", "cognito-idp:CreateUserPoolClient", "cognito-idp:DescribeUserPoolClient", "cognito-idp:UpdateUserPoolClient", "cognito-idp:DeleteUserPoolClient", "cognito-idp:ListUserPoolClients", "cognito-idp:AdminCreateUser", "cognito-idp:AdminGetUser", "cognito-idp:ListUsers", "cognito-idp:TagResource", "cognito-idp:UntagResource", "cognito-idp:ListTagsForResource"], "Resource": "arn:aws:cognito-idp:REGION:ACCOUNT_ID:userpool/*", "Condition": { "StringEquals": { "aws:ResourceTag/Application": "stock-tracker-9000" } } },
    { "Sid": "TagNewAppUserPool", "Effect": "Allow", "Action": "cognito-idp:TagResource", "Resource": "arn:aws:cognito-idp:REGION:ACCOUNT_ID:userpool/*", "Condition": { "StringEquals": { "aws:RequestTag/Application": "stock-tracker-9000" } } },
    { "Sid": "JobAlertTopic", "Effect": "Allow", "Action": ["sns:CreateTopic", "sns:DeleteTopic", "sns:GetTopicAttributes", "sns:SetTopicAttributes", "sns:TagResource", "sns:UntagResource", "sns:ListTagsForResource", "sns:Subscribe", "sns:Unsubscribe", "sns:GetSubscriptionAttributes", "sns:ListSubscriptionsByTopic"], "Resource": ["arn:aws:sns:REGION:ACCOUNT_ID:stock-tracker-9000-job-alerts", "arn:aws:sns:REGION:ACCOUNT_ID:stock-tracker-9000-job-alerts:*"] },
    { "Sid": "SecretConsoleMetadataList", "Effect": "Allow", "Action": "secretsmanager:ListSecrets", "Resource": "*" },
    { "Sid": "DeploymentServiceMetadata", "Effect": "Allow", "Action": ["lambda:GetAccountSettings", "logs:DescribeLogGroups"], "Resource": "*" },
    { "Sid": "AppStack", "Effect": "Allow", "Action": "cloudformation:*", "Resource": ["arn:aws:cloudformation:REGION:ACCOUNT_ID:stack/stock-tracker-9000/*", "arn:aws:cloudformation:REGION:ACCOUNT_ID:changeSet/*/*", "arn:aws:cloudformation:REGION:aws:transform/Serverless-2016-10-31"] },
    { "Sid": "TemplateChecks", "Effect": "Allow", "Action": ["cloudformation:ValidateTemplate", "cloudformation:GetTemplateSummary"], "Resource": "*" },
    { "Sid": "AppResources", "Effect": "Allow", "Action": ["lambda:*", "dynamodb:*", "sqs:*", "logs:*", "cloudwatch:*", "scheduler:*"], "Resource": ["arn:aws:lambda:REGION:ACCOUNT_ID:function:stock-tracker-9000-*", "arn:aws:dynamodb:REGION:ACCOUNT_ID:table/stock-tracker-9000-*", "arn:aws:sqs:REGION:ACCOUNT_ID:stock-tracker-9000-*", "arn:aws:logs:REGION:ACCOUNT_ID:log-group:/aws/lambda/stock-tracker-9000-*", "arn:aws:logs:REGION:ACCOUNT_ID:log-group:/aws/lambda/stock-tracker-9000-*:*", "arn:aws:cloudwatch:REGION:ACCOUNT_ID:alarm:stock-tracker-9000-*", "arn:aws:scheduler:REGION:ACCOUNT_ID:schedule/default/stock-tracker-9000-*"] },
    { "Sid": "ProviderSecretManagementWithoutReadingValues", "Effect": "Allow", "Action": ["secretsmanager:CreateSecret", "secretsmanager:DescribeSecret", "secretsmanager:PutSecretValue", "secretsmanager:UpdateSecret", "secretsmanager:TagResource"], "Resource": "arn:aws:secretsmanager:REGION:ACCOUNT_ID:secret:stock-tracker-9000/providers-*" },
    { "Sid": "CreateBoundedRuntimeRoles", "Effect": "Allow", "Action": "iam:CreateRole", "Resource": "arn:aws:iam::ACCOUNT_ID:role/stock-tracker-9000-*", "Condition": { "StringEquals": { "iam:PermissionsBoundary": "arn:aws:iam::ACCOUNT_ID:policy/stock-tracker-9000-runtime-boundary" } } },
    { "Sid": "ManageAppRoles", "Effect": "Allow", "Action": ["iam:GetRole", "iam:DeleteRole", "iam:TagRole", "iam:UntagRole", "iam:ListRoleTags", "iam:PutRolePolicy", "iam:GetRolePolicy", "iam:ListRolePolicies", "iam:DeleteRolePolicy", "iam:AttachRolePolicy", "iam:DetachRolePolicy", "iam:ListAttachedRolePolicies", "iam:UpdateAssumeRolePolicy"], "Resource": "arn:aws:iam::ACCOUNT_ID:role/stock-tracker-9000-*" },
    { "Sid": "PassAppRoles", "Effect": "Allow", "Action": "iam:PassRole", "Resource": "arn:aws:iam::ACCOUNT_ID:role/stock-tracker-9000-*", "Condition": { "StringEquals": { "iam:PassedToService": ["lambda.amazonaws.com", "scheduler.amazonaws.com"] } } },
    { "Sid": "ReadBoundary", "Effect": "Allow", "Action": ["iam:GetPolicy", "iam:GetPolicyVersion"], "Resource": ["arn:aws:iam::ACCOUNT_ID:policy/stock-tracker-9000-runtime-boundary", "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"] },
    { "Sid": "DeploymentArtifacts", "Effect": "Allow", "Action": ["s3:CreateBucket", "s3:GetBucketLocation", "s3:ListBucket", "s3:GetEncryptionConfiguration", "s3:PutEncryptionConfiguration", "s3:GetBucketPublicAccessBlock", "s3:PutBucketPublicAccessBlock", "s3:GetBucketVersioning", "s3:PutBucketVersioning", "s3:PutBucketTagging", "s3:GetObject", "s3:PutObject", "s3:DeleteObject"], "Resource": ["arn:aws:s3:::stock-tracker-9000-artifacts-ACCOUNT_ID-REGION", "arn:aws:s3:::stock-tracker-9000-artifacts-ACCOUNT_ID-REGION/*"] },
    { "Sid": "OwnConsolePassword", "Effect": "Allow", "Action": ["iam:ChangePassword", "iam:GetUser"], "Resource": "arn:aws:iam::ACCOUNT_ID:user/stock-tracker-deployer" },
    { "Sid": "AccountPasswordRules", "Effect": "Allow", "Action": "iam:GetAccountPasswordPolicy", "Resource": "*" }
  ]
}
